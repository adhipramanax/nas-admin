# ===== NAS Admin — salin jadi .env lalu isi =====

# Port dashboard di NAS -> http://192.168.110.10:8002
APP_PORT=8002
NAS_LAN_IP=192.168.110.10

# Akun admin pertama (hanya dipakai saat database masih kosong)
ADMIN_USERNAME=panji
ADMIN_PASSWORD=ganti-password-ini

# Password database Postgres internal
DB_PASSWORD=ganti-dengan-password-acak

# Rahasia — buat dengan: openssl rand -hex 32
JWT_SECRET=
# PENTING: simpan baik-baik. Jika hilang/berubah, password yang tersimpan tidak bisa dibuka.
ENCRYPTION_KEY=

# Login hanya via http di LAN -> false
COOKIE_SECURE=false
SESSION_HOURS=12

# Alamat host NAS dari dalam container (untuk cek port & health web)
# Jika cek port selalu "tertutup", ganti ke IP LAN: 192.168.110.10
HOST_CHECK_ADDR=host.docker.internal
HEALTH_INTERVAL=120

# Container yang tidak boleh di-stop/restart dari dashboard / AI (pisahkan koma)
PROTECTED_CONTAINERS=nas-admin-app,nas-admin-db,nas-admin-socket-proxy

# ===== AI agent (Ollama) =====
# Sesuaikan port Ollama di NAS Anda. Ollama standar = 11434;
# jika dipasang dari TrueNAS Apps biasanya port lain (mis. 30068) — cek di halaman Port.
OLLAMA_URL=http://host.docker.internal:11434
# Wajib model yang mendukung tool-calling
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=180000

# Isi project awal (TrueNAS, pa-admin, basinang, dll) saat database kosong
SEED_PROJECTS=true

# Darurat 2FA: jika HP & kode cadangan hilang, isi dengan username,
# jalankan `docker compose up -d`, login, lalu HAPUS baris ini lagi.
# RESET_2FA_USER=panji
